"""Verify the PRINTED numbers against the compiled PDF (round 14).

verify.py recomputes every quantitative claim from output/*.json but
never reads the compiled paper, so a transcription error introduced
between the .tex tables and the printed page would pass it. This
companion script closes that gap: it extracts the text layer of the
final PDF (pdftotext), normalises it, recomputes each value from
output/*.json, formats it at the precision the paper prints, and
asserts the formatted string actually appears on the page.

Usage:
    python3 verify_printed.py [path-to-paper.pdf]
Default PDF: ../build-sncs/paper.pdf (the canonical build in this
tree); pass ./paper.pdf inside a deposited package copy.
Run AFTER verify.py.
"""
import json
import math
import subprocess
import sys

import numpy as np

PDF = sys.argv[1] if len(sys.argv) > 1 else "../build-sncs/paper.pdf"

raw = subprocess.run(["pdftotext", PDF, "-"], capture_output=True,
                     text=True, check=True).stdout
# Normalise: unicode minus/en-dash -> ascii, collapse all whitespace.
TEXT = raw.replace("−", "-").replace("–", "-").replace("—", "-")
TEXT = " ".join(TEXT.split())

fails = []
n_checks = 0


def need(label, s):
    global n_checks
    n_checks += 1
    ok = s in TEXT
    print(f"{'PASS' if ok else 'FAIL'}: printed {label}: {s!r}")
    if not ok:
        fails.append(label)


def pm(label, mean, se, dec=3):
    need(label, f"{mean:.{dec}f} ± {se:.{dec}f}")


def need_gap(label, s):
    # Round-32 reflow: a page folio can interleave inside a needle at a
    # page break (r31->r32 build grew 50->51 pp; folios "11" and "28"
    # landed inside the SW27-2 and TF-27-5 needles). Allow one optional
    # short numeric token after any space of the needle; the printed
    # sentences themselves are unchanged and were verified by eye.
    global n_checks
    n_checks += 1
    import re as _re
    pat = _re.escape(s).replace(r"\ ", r"\s+(?:\d{1,3}\s+)?")
    ok = _re.search(pat, TEXT) is not None
    print(f"{'PASS' if ok else 'FAIL'}: printed {label}: {s!r}")
    if not ok:
        fails.append(label)


def need_flex(label, s):
    # Round-30 reflow: pdftotext can split a needle at a line-end dash
    # ("0.023- 0.091") or interleave a float/footnote marker inside it.
    # Accept the needle with a space inserted after any dash as well;
    # the recomputed values themselves are unchanged.
    global n_checks
    n_checks += 1
    ok = s in TEXT or s.replace("-", "- ") in TEXT
    print(f"{'PASS' if ok else 'FAIL'}: printed {label}: {s!r}")
    if not ok:
        fails.append(label)


